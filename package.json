{
  "name": "homedesign",
  "version": "0.1.0",
  "private": true,
  "description": "HomeDesign clone — spec #13. Foundation harness: Next.js (App Router, Turbopack) + OpenNext on Cloudflare Workers, workers runtime test harness, fake AI provider seam, Playwright visual baseline, fixture helpers.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "wrangler:test": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "next lint"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "4.126.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260825.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true
  },
  "type": "module"
}
