# Copy to .dev.vars for local development (gitignored).
# Secrets: commit only NAMES (see ADR 0006), never values.
NEXTJS_ENV=development
ENVIRONMENT=local
BETTER_AUTH_SECRET=change-me-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# EmailDelivery adapter mode: test-outbox (local/dev/preview/staging) only.
EMAIL_DELIVERY_MODE=test-outbox
# Google One Tap (day-1, ADR 0001): per-environment client id, never committed.
# GOOGLE_CLIENT_ID=
