{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homedesign",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "homedesign"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "homedesign-next-cache",
      "preview_bucket_name": "homedesign-next-cache"
    },
    {
      "binding": "HD_PRIVATE",
      "bucket_name": "homedesign-private",
      "preview_bucket_name": "homedesign-private"
    },
    {
      "binding": "HD_PUBLIC",
      "bucket_name": "homedesign-public",
      "preview_bucket_name": "homedesign-public"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homedesign",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASSET_VALIDATE",
        "queue": "homedesign-asset-validate"
      },
      {
        "binding": "PROVIDER_NOTIFY",
        "queue": "homedesign-provider-notify"
      }
    ],
    // Queue CONSUMERS live on the dedicated Validation Worker (separate deploy
    // artifact with its own queue() handler — src/lib/intake/validator.ts).
    // The OpenNext main worker only PRODUCES onto ASSET_VALIDATE and does not
    // export a queue() handler, so no consumers block belongs here.
    // Deploy-time consumer config (ADR 0003 / research):
    //   - homedesign-asset-validate: max_retries 3,
    //     dead_letter_queue: homedesign-asset-validate-dlq
    //   - homedesign-asset-validate-dlq: max_retries 0
    //     (DLQ consumer rejects ONLY the Asset; never touches credits)
  },
  "vars": {
    "ENVIRONMENT": "local",
    // Local-only defaults so `next dev` / e2e run anonymous without .dev.vars.
    // BETTER_AUTH_SECRET must be overridden per environment (secrets.required).
    "BETTER_AUTH_URL": "http://localhost:3000",
    "BETTER_AUTH_SECRET": "dev-only-insecure-secret-for-local-e2e",
    "EMAIL_DELIVERY_MODE": "test-outbox",
    // R2 S3 API credentials for presigned upload URLs. Local placeholders;
    // real values per environment (secrets.required for ACCESS_KEY/SECRET).
    "R2_ACCOUNT_ID": "local-dev-account",
    "R2_ACCESS_KEY_ID": "local-dev-access-key",
    "R2_SECRET_ACCESS_KEY": "local-dev-secret-key"
  },
  "observability": {
    "enabled": true
  }
}